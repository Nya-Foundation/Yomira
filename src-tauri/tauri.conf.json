{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yomira",
  "version": "0.2.2",
  "identifier": "dev.tauri-exviewer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run gen:icons && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yomira",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/image_cache/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app",
      "nsis"
    ],
    "category": "Entertainment",
    "shortDescription": "Cross-platform gallery browser for E-Hentai/ExHentai",
    "longDescription": "Yomira is a cross-platform gallery browser for E-Hentai/ExHentai, a Rust + Tauri 2.0 port of the Ehviewer Android app. It supports gallery browsing and search, favorites, history, blacklists, and a paged or continuous reader. Unofficial client; not affiliated with E-Hentai. Adult content: 18+ only.",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "GPL-3.0-only",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../licenses/Ehviewer_CN_SXJ-LICENSE.txt": "licenses/Ehviewer_CN_SXJ-LICENSE.txt"
    }
  }
}
